{
    "name": "felixmuhoro/laravel-mpesa-cashier",
    "description": "M-Pesa subscription billing for Laravel — monthly/yearly plans, trials, grace periods, invoices.",
    "keywords": ["laravel", "mpesa", "subscription", "billing", "cashier"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felix Muhoro",
            "email": "felix@felixmuhoro.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "felixmuhoro/laravel-mpesa": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FelixMuhoro\MpesaCashier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FelixMuhoro\MpesaCashier\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FelixMuhoro\MpesaCashier\MpesaCashierServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
